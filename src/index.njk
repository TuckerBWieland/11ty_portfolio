<script src="/assets/js/strata.js" defer></script>
<script>
    // Accordion toggles for projects and companies
    document.querySelectorAll('.project-header, .company-header').forEach(button => {
        button.addEventListener('click', () => {
            const item = button.parentElement;
            const list = item.parentElement;
            const isOpen = item.classList.contains('open');

            list.querySelectorAll('.open').forEach(openItem => {
                openItem.classList.remove('open');
                openItem.querySelector('button').setAttribute('aria-expanded', 'false');
            });

            if (!isOpen) {
                item.classList.add('open');
                button.setAttribute('aria-expanded', 'true');
            }
        });
    });

</script>
