<script type="module">
{% raw %}
import * as THREE from 'three';

/*
 * Flythrough: the Strata contour field extruded into depth.
 * Scroll drives a camera along a curved rail through layered
 * contour geometry. The DOM never moves; only the background
 * travels. Reduced motion locks to the hero waypoint.
 */

window.__flythrough = { ready: false, frames: 0, webgl: false, error: null };

(function () {
    'use strict';

    var canvas = document.getElementById('fly');
    var qs = new URLSearchParams(window.location.search);
    var reduceMotion =
        window.matchMedia('(prefers-reduced-motion: reduce)').matches || qs.has('reduced');
    var coarsePointer = window.matchMedia('(pointer: coarse)').matches;

    var TAU = Math.PI * 2;
    function rand(min, max) { return min + Math.random() * (max - min); }
    function pick(arr) { return arr[(Math.random() * arr.length) | 0]; }

    // Muted spectral palette, same family as the 2D Strata field:
    // dusty rose, violet, blue, teal, sage, warm tan.
    // Slightly deepened so the hues survive the averaging of many
    // overlapping translucent lines; alpha stays low so the field
    // keeps its contemplative register.
    var PALETTE = [
        [224, 102, 142],
        [148, 112, 218],
        [104, 124, 238],
        [ 72, 190, 196],
        [176, 182, 142],
        [232, 196, 152]
    ];

    var renderer;
    try {
        renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: false, powerPreference: 'default' });
    } catch (err) {
        window.__flythrough.error = 'renderer: ' + (err && err.message);
        canvas.style.display = 'none';
        return;
    }
    window.__flythrough.webgl = true;

    var scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0b0c11);

    var camera = new THREE.PerspectiveCamera(55, 1, 0.5, 1400);

    var portrait = window.innerWidth < window.innerHeight;
    var DEPTH = portrait ? 0.55 : 1.0; // shortened rail on portrait screens

    scene.fog = new THREE.Fog(0x0b0c11, 60 * DEPTH, 380 * DEPTH);

    // One shared time uniform; the vertex wobble phases off world position
    // so every layer drifts on its own slow rhythm.
    var timeU = { value: 0 };
    function strataMaterial(opacity) {
        var m = new THREE.LineBasicMaterial({
            vertexColors: true,
            transparent: true,
            opacity: opacity,
            fog: true
        });
        m.onBeforeCompile = function (shader) {
            shader.uniforms.uTime = timeU;
            shader.vertexShader =
                'uniform float uTime;\n' +
                shader.vertexShader.replace(
                    '#include <begin_vertex>',
                    '#include <begin_vertex>\n' +
                    'transformed.y += sin(transformed.x * 0.021 + transformed.z * 0.045 + uTime * 0.12) * 1.15;'
                );
        };
        return m;
    }

    // Contour canyon: vertical strata walls receding into depth, each a dense
    // band of wavy contour polylines with the sine field flavor of the 2D
    // page. The camera weaves through the volume; fog dissolves the far
    // walls into haze the color of the page base.
    var LAYERS = 15;
    var layerGroup = new THREE.Group();
    function buildLayers() {
        for (var li = 0; li < LAYERS; li++) {
            var z = (60 - li * 26) * DEPTH;
            var bandBase = 26 - li * 0.9 + rand(-6, 6);
            var linesPerBand = 24;
            var xMin = -190, xMax = 190, step = 4;
            var positions = [];
            var colors = [];
            for (var l = 0; l < linesPerBand; l++) {
                var c1 = pick(PALETTE), c2 = pick(PALETTE);
                var accent = Math.random() < 0.16;
                var bright = accent ? 1.0 : 0.85;
                var baseY = bandBase + (l - linesPerBand / 2) * 4.5 + rand(-1.5, 1.5);
                var a1 = rand(10, 26), f1 = rand(0.0015, 0.0035), p1 = rand(0, TAU);
                var a2 = rand(5, 14),  f2 = rand(0.004, 0.0085),  p2 = rand(0, TAU);
                var a3 = rand(2, 7),   f3 = rand(0.011, 0.022),   p3 = rand(0, TAU);
                var px = null, py = null, pr = 0, pg = 0, pb = 0;
                for (var x = xMin; x <= xMax; x += step) {
                    var y = baseY
                        + a1 * Math.sin(x * f1 + p1)
                        + a2 * Math.sin(x * f2 + p2)
                        + a3 * Math.sin(x * f3 + p3);
                    var mixT = (x - xMin) / (xMax - xMin);
                    var r = ((c1[0] * (1 - mixT) + c2[0] * mixT) / 255) * bright;
                    var g = ((c1[1] * (1 - mixT) + c2[1] * mixT) / 255) * bright;
                    var b = ((c1[2] * (1 - mixT) + c2[2] * mixT) / 255) * bright;
                    if (px !== null) {
                        positions.push(px, py, z, x, y, z);
                        colors.push(pr, pg, pb, r, g, b);
                    }
                    px = x; py = y; pr = r; pg = g; pb = b;
                }
            }
            var geo = new THREE.BufferGeometry();
            geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
            geo.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
            var mesh = new THREE.LineSegments(geo, strataMaterial(0.14));
            mesh.frustumCulled = false;
            layerGroup.add(mesh);
        }
    }
    buildLayers();
    scene.add(layerGroup);

    // Soft radial glow texture for the cursor light and the end of the rail.
    function glowTexture() {
        var c = document.createElement('canvas');
        c.width = c.height = 256;
        var ctx = c.getContext('2d');
        var g = ctx.createRadialGradient(128, 128, 0, 128, 128, 128);
        g.addColorStop(0, 'rgba(232, 206, 168, 0.55)');
        g.addColorStop(0.45, 'rgba(216, 190, 154, 0.18)');
        g.addColorStop(1, 'rgba(216, 190, 154, 0)');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, 256, 256);
        var tex = new THREE.CanvasTexture(c);
        return tex;
    }
    var glowTex = glowTexture();

    // Brighter patch of light waiting at the end of the rail (contact).
    var endGlow = new THREE.Sprite(new THREE.SpriteMaterial({
        map: glowTex, blending: THREE.AdditiveBlending,
        depthWrite: false, transparent: true, opacity: 0.5, fog: false
    }));
    endGlow.scale.set(90, 90, 1);
    endGlow.position.set(0, 60, -335 * DEPTH);
    scene.add(endGlow);

    // Warm cursor light that drifts through the field, like the 2D page.
    var cursorGlow = new THREE.Sprite(new THREE.SpriteMaterial({
        map: glowTex, blending: THREE.AdditiveBlending,
        depthWrite: false, transparent: true, opacity: 0.12, fog: false
    }));
    cursorGlow.scale.set(70, 70, 1);
    scene.add(cursorGlow);

    // The camera rail: one composed waypoint per content section.
    // Hero wide and high over the field, projects down inside it with
    // lines passing at the frame edges, experience at the calmest open
    // waypoint, contact rising gently toward the brighter patch of light.
    var rail;
    function buildRail() {
        function v(x, y, z) { return new THREE.Vector3(x, y, z * DEPTH); }
        var pts = [
            v(0, 58, 105),
            v(32, 44, 30),
            v(-30, 32, -50),
            v(-6, 36, -130),
            v(12, 38, -208),
            v(0, 54, -284)
        ];
        rail = new THREE.CatmullRomCurve3(pts, false, 'centripetal', 0.5);
    }
    buildRail();

    // Scroll authority: raw scroll target, double smoothed per frame.
    var rawT = 0, smoothT = 0;
    function readScroll() {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        rawT = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    }
    window.addEventListener('scroll', readScroll, { passive: true });
    window.addEventListener('resize', function () {
        readScroll();
        resize();
    });
    readScroll();

    // Pointer parallax target, additive and small.
    var par = { x: 0, y: 0, tx: 0, ty: 0 };
    if (!coarsePointer) {
        window.addEventListener('pointermove', function (e) {
            par.tx = (e.clientX / window.innerWidth - 0.5) * 2;
            par.ty = (e.clientY / window.innerHeight - 0.5) * 2;
        });
        document.documentElement.addEventListener('mouseleave', function () {
            par.tx = 0; par.ty = 0;
        });
    }

    function resize() {
        var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        var w = window.innerWidth, h = window.innerHeight;
        renderer.setPixelRatio(dpr);
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        var nowPortrait = w < h;
        if (nowPortrait !== portrait) {
            portrait = nowPortrait;
            DEPTH = portrait ? 0.55 : 1.0;
            scene.fog.near = 60 * DEPTH;
            scene.fog.far = 380 * DEPTH;
            while (layerGroup.children.length) {
                var child = layerGroup.children.pop();
                child.geometry.dispose();
                child.material.dispose();
            }
            buildLayers();
            buildRail();
            endGlow.position.set(0, 60, -335 * DEPTH);
        }
    }
    resize();

    var camPos = new THREE.Vector3();
    var camAhead = new THREE.Vector3();
    var lookTarget = new THREE.Vector3();
    var glowTarget = new THREE.Vector3();

    function renderFrame(time, dt) {
        // Cinematic lag: lerp toward the scroll target every frame.
        var k = 1 - Math.exp(-dt * 4.0);
        smoothT += (rawT - smoothT) * k;
        var t = Math.min(1, Math.max(0, smoothT));

        rail.getPointAt(t, camPos);
        // Look along the rail tangent for a natural forward lean.
        // Tangent stays well defined at the end of the rail, where a
        // lookAt point on the curve would go degenerate.
        rail.getTangentAt(Math.min(0.999, t), camAhead);
        lookTarget.copy(camPos).addScaledVector(camAhead, 30);
        lookTarget.y += 2;

        // Slow idle sway plus a small pointer parallax layer, both additive.
        par.x += (par.tx - par.x) * (1 - Math.exp(-dt * 2.5));
        par.y += (par.ty - par.y) * (1 - Math.exp(-dt * 2.5));
        var swayX = Math.sin(time * 0.073 + 1.7) * 2.2;
        var swayY = Math.sin(time * 0.11) * 1.6;

        camera.position.set(
            camPos.x + swayX + par.x * 5,
            camPos.y + swayY - par.y * 3.5,
            camPos.z
        );
        camera.lookAt(lookTarget);

        // Cursor light drifts ahead of the camera through the field.
        var gpx = coarsePointer ? Math.sin(time * 0.11) * 0.6 : par.x;
        var gpy = coarsePointer ? Math.sin(time * 0.17 + 1.4) * 0.5 : -par.y;
        glowTarget.set(
            camera.position.x + gpx * 60,
            camera.position.y + gpy * 40 + 6,
            camera.position.z - 130 * DEPTH
        );
        cursorGlow.position.lerp(glowTarget, 1 - Math.exp(-dt * 3));

        // The far light breathes almost imperceptibly.
        endGlow.material.opacity = 0.5 + Math.sin(time * 0.23) * 0.08;

        timeU.value = time;
        renderer.render(scene, camera);
        window.__flythrough.frames++;
    }

    // Synchronous pixel read for composition checks: renders one frame,
    // then reads the RGBA byte at a normalized viewport position before
    // the drawing buffer is released.
    window.__flythrough.readPixel = function (nx, ny) {
        renderFrame(8.0, 1 / 60);
        var gl = renderer.getContext();
        var px = new Uint8Array(4);
        gl.readPixels(
            Math.floor(nx * gl.drawingBufferWidth),
            Math.floor((1 - ny) * gl.drawingBufferHeight),
            1, 1, gl.RGBA, gl.UNSIGNED_BYTE, px
        );
        return [px[0], px[1], px[2], px[3]];
    };

    // Live scene access for deeper debugging from the console.
    window.__flythrough.debug = {
        THREE: THREE, scene: scene, camera: camera,
        rail: rail, endGlow: endGlow, cursorGlow: cursorGlow,
        smoothT: function () { return smoothT; }
    };

    if (reduceMotion) {
        // One composed static frame locked to the hero waypoint.
        smoothT = 0; rawT = 0;
        renderFrame(8.0, 1 / 60);
        window.__flythrough.ready = true;
        return;
    }

    var running = true;
    var last = performance.now();
    function loop(now) {
        if (!running) return;
        var dt = Math.min((now - last) / 1000, 0.1);
        last = now;
        renderFrame(now / 1000, dt);
        window.__flythrough.ready = true;
        requestAnimationFrame(loop);
    }

    document.addEventListener('visibilitychange', function () {
        if (document.hidden) {
            running = false;
        } else if (!reduceMotion) {
            running = true;
            last = performance.now();
            requestAnimationFrame(loop);
        }
    });

    // Debug hook for waypoint screenshots: ?scrollfrac=0.5
    if (qs.has('scrollfrac')) {
        var f = parseFloat(qs.get('scrollfrac'));
        if (isFinite(f)) {
            requestAnimationFrame(function () {
                var max = document.documentElement.scrollHeight - window.innerHeight;
                window.scrollTo(0, Math.min(1, Math.max(0, f)) * max);
                readScroll();
                smoothT = rawT;
            });
        }
    }

    requestAnimationFrame(loop);
})();
{% endraw %}
</script>

<script>
{% raw %}
(function () {
    'use strict';

    // Accordion toggles for projects and companies
    document.querySelectorAll('.project-header, .company-header').forEach(function (button) {
        button.addEventListener('click', function () {
            var item = button.parentElement;
            var list = item.parentElement;
            var isOpen = item.classList.contains('open');

            list.querySelectorAll('.open').forEach(function (openItem) {
                openItem.classList.remove('open');
                openItem.querySelector('button').setAttribute('aria-expanded', 'false');
            });

            if (!isOpen) {
                item.classList.add('open');
                button.setAttribute('aria-expanded', 'true');
            }
        });
    });

    // Scroll driven calm: the scrim behind each dense list fades in
    // as its section arrives on screen, and holds while you read.
    var sections = Array.prototype.slice.call(document.querySelectorAll('.projects, .experience'));
    if (sections.length) {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            sections.forEach(function (el) { el.style.setProperty('--calm', 1); });
        } else {
            var ticking = false;
            var update = function () {
                ticking = false;
                var vh = window.innerHeight;
                sections.forEach(function (el) {
                    var top = el.getBoundingClientRect().top;
                    var t = (vh - top) / (vh * 0.45);
                    t = Math.max(0, Math.min(1, t));
                    el.style.setProperty('--calm', t.toFixed(3));
                });
            };
            var onScroll = function () {
                if (!ticking) { ticking = true; requestAnimationFrame(update); }
            };
            window.addEventListener('scroll', onScroll, { passive: true });
            window.addEventListener('resize', onScroll);
            update();
        }
    }
})();
{% endraw %}
</script>
