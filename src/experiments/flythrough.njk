<style>
{% raw %}
@font-face {
    font-family: 'IBM Plex Mono';
    font-weight: 400;
    font-style: normal;
    font-display: optional;
    src: url('../../fonts/ibm-plex-mono-latin-400-normal.woff2') format('woff2'),
         url('../../fonts/ibm-plex-mono-latin-400-normal.woff') format('woff');
}
@font-face {
    font-family: 'IBM Plex Mono';
    font-weight: 700;
    font-style: normal;
    font-display: optional;
    src: url('../../fonts/ibm-plex-mono-latin-700-normal.woff2') format('woff2'),
         url('../../fonts/ibm-plex-mono-latin-700-normal.woff') format('woff');
}

:root {
    --bg-primary: #0b0c11;
    --text-primary: #ffffff;
    --text-secondary: rgb(255 255 255 / 55%);
    --text-tertiary: rgb(255 255 255 / 32%);
    --border: rgb(255 255 255 / 10%);
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
}

::selection { background: #f2efe8; color: #101218; }

a:focus-visible, button:focus-visible {
    outline: 2px solid #f2efe8;
    outline-offset: 3px;
    border-radius: 2px;
}

/* The 3D strata field, fixed behind everything */
#fly {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    pointer-events: none;
}

/* Soft page scrim between the field and the content */
.page-scrim {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
        radial-gradient(120% 90% at 50% 18%, rgb(11 12 17 / 16%), rgb(11 12 17 / 0%) 55%),
        linear-gradient(to bottom, rgb(11 12 17 / 24%), rgb(11 12 17 / 46%) 62%, rgb(11 12 17 / 56%));
}

.content { position: relative; z-index: 1; }

section { padding: 0 20px; max-width: 720px; margin: 0 auto; }
@media (width >= 640px) { section { padding: 0 40px; } }
@media (width >= 1024px) { section { padding: 0 24px; max-width: 800px; } }

/* Gentle lift for text over the field */
.projects, .experience, .contact, .site-footer { text-shadow: 0 1px 16px rgb(0 0 0 / 55%); }

/* Calm patch behind the dense lists */
.projects, .experience { position: relative; }
.projects::before, .experience::before {
    content: '';
    position: absolute;
    inset: -12px 0;
    z-index: -1;
    background: rgb(11 12 17 / 55%);
    filter: blur(28px);
    pointer-events: none;
    opacity: var(--calm, 0);
}
@media (width >= 640px) { .projects::before, .experience::before { inset: -16px -48px; } }

/* ---------- nav ---------- */
.site-nav {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
}
@media (width >= 640px) { .site-nav { padding: 24px 40px; } }
.site-nav-name {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: -0.01em;
}
.site-nav-links { display: flex; align-items: center; gap: 20px; }
.site-nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.8125rem;
    transition: color 0.2s ease;
}
.site-nav-link:hover { color: var(--text-primary); }
@media (width <= 640px) {
    .site-nav { padding: 16px 20px; }
    .site-nav-links { gap: 14px; }
    .site-nav-link { font-size: 0.75rem; }
}

/* ---------- hero ---------- */
.hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    max-width: none;
    margin: 0;
    padding: 0 24px;
    overflow: clip;
}
.hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
        linear-gradient(to top, rgb(11 12 17 / 72%), rgb(11 12 17 / 0%) 34%),
        radial-gradient(115% 85% at 50% 8%, rgb(11 12 17 / 0%) 52%, rgb(11 12 17 / 55%));
}
.hero-content { position: relative; z-index: 1; text-align: center; }
.hero-name {
    font-size: clamp(2.75rem, 9vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-bottom: 34px;
    text-shadow: 0 2px 30px rgb(0 0 0 / 60%);
}
.hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

.button {
    display: inline-block;
    padding: 13px 28px;
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #101218;
    background: #f2efe8;
    border: none;
    border-radius: 999px;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    box-shadow: 0 10px 30px rgb(0 0 0 / 45%);
}
.button:hover { transform: translateY(-2px); background: #ffffff; box-shadow: 0 14px 36px rgb(0 0 0 / 50%); }
.button-ghost {
    color: #f2efe8;
    background: rgb(255 255 255 / 4%);
    border: 1px solid rgb(255 255 255 / 22%);
    box-shadow: none;
    backdrop-filter: blur(6px);
}
.button-ghost:hover { background: rgb(255 255 255 / 9%); border-color: rgb(255 255 255 / 40%); box-shadow: none; }

/* ---------- section titles ---------- */
.section-title {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 20px;
}
@media (width >= 640px) { .section-title { margin-bottom: 28px; } }

/* ---------- accordions ---------- */
.projects, .experience { padding-top: 40px; padding-bottom: 40px; }
@media (width >= 640px) { .projects, .experience { padding-top: 60px; padding-bottom: 60px; } }

.project-list, .company-list { list-style: none; }
.project-item, .company-item { border-bottom: 1px solid var(--border); }
.project-item:first-child, .company-item:first-child { border-top: 1px solid var(--border); }

.project-header, .company-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    width: 100%;
    padding: 14px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    color: inherit;
}
@media (width >= 640px) { .project-header, .company-header { padding: 18px 0; } }

.project-name, .company-name {
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    font-weight: 500;
    letter-spacing: -0.01em;
}
.project-meta, .company-meta { display: flex; align-items: baseline; gap: 16px; flex-shrink: 0; }
.project-company, .company-role {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--text-secondary);
    text-align: right;
}
.toggle-icon {
    width: 16px; height: 16px;
    color: var(--text-tertiary);
    transition: transform 0.2s ease;
    flex-shrink: 0;
}
.project-item.open .toggle-icon, .company-item.open .toggle-icon { transform: rotate(180deg); }

.project-item, .company-item { transition: background-color 0.25s ease; }
.project-item.open, .company-item.open {
    background: rgb(11 12 17 / 62%);
    border-radius: 12px;
    padding-left: 18px;
    padding-right: 18px;
    margin-left: -18px;
    margin-right: -18px;
}

.project-details, .company-details {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
}
.project-item.open .project-details { max-height: 1600px; padding-bottom: 16px; }
.company-item.open .company-details { max-height: 400px; padding-bottom: 16px; }
@media (width >= 640px) {
    .project-item.open .project-details, .company-item.open .company-details { padding-bottom: 20px; }
}

.project-bullets, .company-bullets { list-style: none; margin-bottom: 12px; }
.project-bullets li, .company-bullets li {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    padding-left: 16px;
    margin-bottom: 6px;
    position: relative;
    line-height: 1.5;
}
@media (width >= 640px) {
    .project-bullets li, .company-bullets li { font-size: 0.875rem; margin-bottom: 8px; }
}
.project-bullets li::before, .company-bullets li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.6em;
    width: 5px; height: 5px;
    background: var(--text-tertiary);
}
.project-link, .company-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #f2efe8;
    text-decoration: none;
    transition: opacity 0.2s ease;
}
.project-link:hover, .company-link:hover { opacity: 0.75; }
@media (width <= 639px) {
    .project-link, .company-link { display: block; margin-bottom: 10px; }
    .project-link:last-child, .company-link:last-child { margin-bottom: 0; }
}

/* ---------- contact ---------- */
.contact { padding-top: 40px; padding-bottom: 60px; }
@media (width >= 640px) { .contact { padding-top: 60px; padding-bottom: 80px; } }
.contact-links { display: flex; flex-direction: column; gap: 4px; }
.contact-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 0;
    color: var(--text-primary);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    width: fit-content;
    transition: color 0.2s ease;
}
.contact-link:hover { color: var(--text-secondary); }
.contact-link .arrow { width: 16px; height: 16px; transition: transform 0.2s ease; }
.contact-link:hover .arrow { transform: translate(2px, -2px); }

/* ---------- footer ---------- */
.site-footer { max-width: 800px; margin: 0 auto; padding: 0 20px 32px; }
@media (width >= 640px) { .site-footer { padding: 0 40px 40px; } }
.site-footer p { font-size: 0.75rem; color: var(--text-tertiary); }

/* ---------- experiment tag ---------- */
.exp-tag {
    position: fixed;
    left: 16px; bottom: 14px;
    z-index: 5;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    pointer-events: none;
}

@media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .button, .contact-link .arrow, .toggle-icon,
    .project-item, .company-item, .project-details, .company-details { transition: none; }
}
{% endraw %}
</style>
