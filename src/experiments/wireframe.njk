<script>
(function () {
  'use strict';

  var params = new URLSearchParams(location.search);
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  var reduced = prefersReduced.matches || params.get('reduced') === '1';

  var motionToggle = document.getElementById('motion-toggle');
  var readout = document.getElementById('render-readout');
  var hudProgress = document.getElementById('hud-progress');
  var grid = document.getElementById('construction-grid');
  var stages = Array.prototype.slice.call(document.querySelectorAll('.stage[data-stage]'));

  function smoothstep(a, b, x) {
    var t = Math.min(1, Math.max(0, (x - a) / (b - a)));
    return t * t * (3 - 2 * t);
  }
  function clamp(v, a, b) { return v < a ? a : (v > b ? b : v); }

  function setMotionUI() {
    document.documentElement.classList.toggle('rm', reduced);
    if (motionToggle) {
      motionToggle.setAttribute('aria-pressed', reduced ? 'true' : 'false');
      motionToggle.textContent = reduced ? 'Restore motion' : 'Reduce motion';
    }
    if (readout) {
      readout.textContent = reduced ? 'render complete' : 'rendering\u2026 000%';
      readout.classList.toggle('done', reduced);
    }
    if (hudProgress) hudProgress.style.width = reduced ? '100%' : '0';
  }

  /* Per-stage render progress, driven by scroll position against each
     stage's document offset. At load (scrollY = 0) every stage is
     wireframe; scrolling sweeps the render down the page. */
  var stageTops = [];
  function measure() {
    var sy = window.scrollY || window.pageYOffset || 0;
    stageTops = stages.map(function (st) {
      return st.getBoundingClientRect().top + sy;
    });
  }

  function stageProgress(i) {
    var vh = window.innerHeight;
    var sy = window.scrollY || window.pageYOffset || 0;
    var maxScroll = Math.max(1, document.documentElement.scrollHeight - vh);
    var start = Math.max(0, stageTops[i] - vh * 0.9);
    /* Clamp the window so the last stage can always finish rendering. */
    var end = Math.min(start + vh * 0.55, maxScroll);
    if (end <= start) return sy >= start ? 1 : 0;
    return smoothstep(start, end, sy);
  }

  function update() {
    if (reduced) return;
    var vh = window.innerHeight;
    var maxScroll = Math.max(1, document.documentElement.scrollHeight - vh);
    var sy = window.scrollY || window.pageYOffset || 0;
    var overall = clamp(sy / maxScroll, 0, 1);

    stages.forEach(function (st, i) {
      var p = stageProgress(i);
      var wf = st.querySelector('.layer-wf');
      var fin = st.querySelector('.layer-fin');
      if (!wf || !fin) return;
      if (p <= 0.001) {
        st.classList.remove('rendering', 'rendered');
        wf.style.opacity = '1'; wf.style.transform = '';
        fin.style.opacity = '0'; fin.style.transform = '';
      } else if (p >= 0.999) {
        st.classList.remove('rendering');
        st.classList.add('rendered');
        wf.style.opacity = '0';
        fin.style.opacity = '1'; fin.style.transform = '';
      } else {
        st.classList.add('rendering');
        st.classList.remove('rendered');
        wf.style.opacity = String(1 - p);
        wf.style.transform = 'translateY(' + (-10 * p).toFixed(1) + 'px)';
        fin.style.opacity = String(p);
        fin.style.transform = 'translateY(' + (22 * (1 - p)).toFixed(1) + 'px)';
      }
    });

    /* Persistent progress: the readout and the construction grid. */
    var pct = Math.round(overall * 100);
    if (readout) {
      var done = overall >= 0.995;
      readout.textContent = done ? 'render complete'
        : 'rendering\u2026 ' + String(pct).padStart(3, '0') + '%';
      readout.classList.toggle('done', done);
    }
    if (hudProgress) hudProgress.style.width = (overall * 100).toFixed(1) + '%';
    if (grid) grid.style.opacity = (0.55 - overall * 0.47).toFixed(3);
  }

  /* Accordions in the finished layer: click, touch-native, no hover. */
  document.querySelectorAll('.project-card, .company-item').forEach(function (item) {
    var button = item.querySelector('.project-toggle, .company-header');
    if (!button) return;
    button.addEventListener('click', function () {
      var isOpen = item.classList.contains('open');
      var siblings = item.parentElement.querySelectorAll('.open');
      siblings.forEach(function (sib) {
        sib.classList.remove('open');
        var b = sib.querySelector('.project-toggle, .company-header');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });

  /* Scroll drives everything: rAF-throttled, transform/opacity only. */
  var ticking = false;
  function requestUpdate() {
    if (ticking || reduced) return;
    ticking = true;
    requestAnimationFrame(function () {
      ticking = false;
      update();
    });
  }
  window.addEventListener('scroll', requestUpdate, { passive: true });
  var resizeTimer = 0;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () { measure(); requestUpdate(); }, 120);
  });
  window.addEventListener('load', function () { measure(); requestUpdate(); });

  if (motionToggle) {
    motionToggle.addEventListener('click', function () {
      reduced = !reduced;
      setMotionUI();
      stages.forEach(function (st) {
        var wf = st.querySelector('.layer-wf');
        var fin = st.querySelector('.layer-fin');
        if (wf) { wf.style.opacity = ''; wf.style.transform = ''; }
        if (fin) { fin.style.opacity = ''; fin.style.transform = ''; }
        st.classList.remove('rendering', 'rendered');
      });
      if (reduced && grid) grid.style.opacity = '';
      if (!reduced) requestUpdate();
    });
  }
  if (prefersReduced.addEventListener) {
    prefersReduced.addEventListener('change', function (e) {
      if (e.matches && !reduced) {
        reduced = true;
        setMotionUI();
      }
    });
  }

  setMotionUI();
  measure();
  update();

  /* Screenshot helpers: ?shot=mid lands on Projects, ?shot=end on Contact */
  var shot = params.get('shot');
  if (shot === 'mid' || shot === 'end') {
    var target = document.querySelector(shot === 'mid' ? '.stage-projects' : '.stage-contact');
    if (target) {
      window.scrollTo(0, Math.max(0, target.getBoundingClientRect().top + window.scrollY - window.innerHeight * 0.25));
      requestAnimationFrame(update);
    }
  }
})();
</script>
