              <li>Managed $35M in client spend across B2B and B2C campaigns</li>
            </ul>
          </div></div>
        </li>
      </ul>
    </section>

    <section class="contact" id="contact">
      <h2 class="section-title reveal">Get in Touch</h2>
      <div class="contact-links reveal">
        <a href="/resume/tucker-wieland-resume.pdf" download class="contact-link">
          Resume
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v12m0 0l-5-5m5 5l5-5M5 20h14"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/tucker-wieland/" target="_blank" rel="noopener noreferrer" class="contact-link">
          LinkedIn
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
        </a>
        <a href="https://github.com/TuckerBWieland/" target="_blank" rel="noopener noreferrer" class="contact-link">
          GitHub
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <p>&copy; 2026 Tucker Wieland. An <a href="/experiments/">experiment</a> in ambient weather.</p>
  </footer>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="../../assets/js/vendor/lenis.min.js"></script>
<script>
(function () {
  'use strict';

  var params = new URLSearchParams(location.search);
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches || params.get('reduced') === '1';
  var coarsePointer = window.matchMedia('(pointer: coarse)').matches;
  var smallScreen = Math.min(window.innerWidth, window.innerHeight) < 700;

  /* ============ Scroll authority: Lenis owned by the GSAP ticker ============ */
  var lenis = null;
  var hasGsap = typeof gsap !== 'undefined';
  if (hasGsap && typeof ScrollTrigger !== 'undefined') gsap.registerPlugin(ScrollTrigger);

  if (!reduceMotion && typeof Lenis !== 'undefined') {
    lenis = new Lenis({ lerp: 0.09, smoothWheel: true });
    if (hasGsap) {
      lenis.on('scroll', function () {
        if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.update();
      });
      gsap.ticker.add(function (time) { lenis.raf(time * 1000); });
      gsap.ticker.lagSmoothing(0);
    } else {
      (function raf(t) { lenis.raf(t); requestAnimationFrame(raf); })(0);
    }
  }

  function currentScroll() {
    if (lenis) return lenis.scroll;
    return window.scrollY || window.pageYOffset || 0;
  }

  /* ============ Accordions: same toggle, plus a faint warm shimmer ============ */
  document.querySelectorAll('.project-header, .company-header').forEach(function (button) {
    button.addEventListener('click', function () {
      var item = button.parentElement;
      var list = item.parentElement;
      var isOpen = item.classList.contains('open');
      list.querySelectorAll('.open').forEach(function (openItem) {
        openItem.classList.remove('open');
        openItem.querySelector('button').setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        button.setAttribute('aria-expanded', 'true');
        if (!reduceMotion) {
          item.classList.remove('shimmer');
          void item.offsetWidth;
          item.classList.add('shimmer');
          if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
        }
      } else if (typeof ScrollTrigger !== 'undefined') {
        ScrollTrigger.refresh();
      }
    });
  });
  document.querySelectorAll('.shimmer').forEach(function (el) {
    el.addEventListener('animationend', function () { el.classList.remove('shimmer'); });
  });

  /* ============ Section reveals: slow blur to focus, small settle ============ */
  if (!reduceMotion && hasGsap && typeof ScrollTrigger !== 'undefined') {
    gsap.utils.toArray('.reveal').forEach(function (el) {
      gsap.from(el, {
        y: 18,
        opacity: 0,
        filter: 'blur(6px)',
        duration: 0.95,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 88%',
          toggleActions: 'play none none reverse'
        }
      });
    });
  }

  /* ============================================================
     Atmosphere canvas: one fixed field, four depth planes.
     Back to front: warm haze and light shaft (plane 1),
     Strata contour lines (plane 2), dust motes (plane 3),
     film grain (plane 4). Each plane drifts at its own
     parallax rate against scroll, so the DOM sits in depth.
     ============================================================ */
  var canvas = document.getElementById('atmo');
  var ctx = canvas.getContext('2d');
  var W = 0, H = 0, DPR = 1;
  var lines = [];
  var motes = [];
  var grainTile = null, grainPattern = null;
  var moteSprite = null;
  var pointer = { x: -10000, y: -10000, tx: -10000, ty: -10000 };
  var scrollY = 0, lastScrollY = 0;
  var stir = 0; /* damped scroll velocity, stirs the dust then settles */
  var elapsed = 0, lastT = 0;
  var running = true;

  function rand(min, max) { return min + Math.random() * (max - min); }
  function pick(arr) { return arr[(Math.random() * arr.length) | 0]; }
  function rgba(c, a) { return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + a.toFixed(3) + ')'; }
  function mix(c1, c2) {
    return [Math.round((c1[0] + c2[0]) / 2), Math.round((c1[1] + c2[1]) / 2), Math.round((c1[2] + c2[2]) / 2)];
  }

  /* Muted spectral sweep, same family as the live Strata field */
  var PALETTE = [
    [216, 110, 150], [150, 120, 205], [110, 130, 230],
    [80, 185, 190], [170, 175, 150], [225, 200, 160]
  ];

  function makeLineGradient(c1, c2, alpha) {
    var g = ctx.createLinearGradient(0, 0, W, 0);
    g.addColorStop(0, rgba(c1, alpha));
    g.addColorStop(0.5, rgba(mix(c1, c2), alpha));
    g.addColorStop(1, rgba(c2, alpha));
    return g;
  }

  function buildLines() {
    lines = [];
    var baseGap = H < 520 ? 22 : 30;
    var y = -baseGap;
    while (y < H + baseGap) {
      var c1 = pick(PALETTE), c2 = pick(PALETTE);
      lines.push({
        y: y,
        a1: rand(9, 24), f1: rand(0.0015, 0.003), s1: rand(0.08, 0.2), p1: rand(0, 6.2832),
        a2: rand(5, 14), f2: rand(0.004, 0.0085), s2: rand(0.12, 0.28), p2: rand(0, 6.2832),
        a3: rand(2, 7), f3: rand(0.011, 0.022), s3: rand(0.18, 0.4), p3: rand(0, 6.2832),
        accent: Math.random() < 0.16,
        jitter: rand(0.7, 1.25),
        grad: makeLineGradient(c1, c2, 0.15),
        gradAccent: makeLineGradient(c1, c2, 0.34)
      });
      y += baseGap * rand(0.65, 1.45);
    }
  }

  function makeMoteSprite() {
    var s = 64;
    moteSprite = document.createElement('canvas');
    moteSprite.width = s; moteSprite.height = s;
    var c = moteSprite.getContext('2d');
    var g = c.createRadialGradient(s / 2, s / 2, 0, s / 2, s / 2, s / 2);
    g.addColorStop(0, 'rgba(255,244,228,1)');
    g.addColorStop(0.35, 'rgba(255,240,220,0.42)');
    g.addColorStop(1, 'rgba(255,240,220,0)');
    c.fillStyle = g;
    c.fillRect(0, 0, s, s);
  }

  function buildMotes() {
    motes = [];
    var count = smallScreen ? 130 : 400;
    for (var i = 0; i < count; i++) {
      motes.push({
        x: rand(0, W), y: rand(0, H),
        r: rand(1.1, 3.4),
        depth: rand(0.3, 1),
        phase: rand(0, 6.2832),
        speed: rand(0.6, 1.4),
        ox: 0, oy: 0
      });
    }
  }

  function makeGrain() {
    var s = 128;
    grainTile = document.createElement('canvas');
    grainTile.width = s; grainTile.height = s;
    var c = grainTile.getContext('2d');
    var img = c.createImageData(s, s);
    var d = img.data;
    for (var i = 0; i < d.length; i += 4) {
      var v = 108 + Math.random() * 40;
      d[i] = v; d[i + 1] = v; d[i + 2] = v; d[i + 3] = 255;
    }
    c.putImageData(img, 0, 0);
    grainPattern = ctx.createPattern(grainTile, 'repeat');
  }

  function field(x, L, t) {
    return (
      L.a1 * Math.sin(x * L.f1 + t * L.s1 + L.p1) +
      L.a2 * Math.sin(x * L.f2 - t * L.s2 + L.p2) +
      L.a3 * Math.sin(x * L.f3 + t * L.s3 + L.p3)
    );
  }

  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 1.5);
    W = window.innerWidth;
    H = window.innerHeight;
    smallScreen = Math.min(W, H) < 700;
    canvas.width = Math.max(1, Math.round(W * DPR));
    canvas.height = Math.max(1, Math.round(H * DPR));
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    buildLines();
    buildMotes();
    if (grainOn()) makeGrain();
  }

  function grainOn() { return !smallScreen && !reduceMotion; }

  /* ---- Plane 1: warm haze plus a breathing light shaft ---- */
  function drawHaze(t, scroll) {
    var off = scroll * 0.10;

    var hz = ctx.createRadialGradient(W * 0.72, H * 0.9 - off * 0.4, 0, W * 0.72, H * 0.9 - off * 0.4, W * 0.45);
    hz.addColorStop(0, 'rgba(255,190,140,0.045)');
    hz.addColorStop(1, 'rgba(255,190,140,0)');
    ctx.fillStyle = hz;
    ctx.fillRect(0, 0, W, H);

    /* Light shaft, diagonal, breathing on a ~26s cycle */
    var breathe = 0.030 + 0.020 * Math.sin((t * 6.2832) / 26 + 1.0);
    var sx = W * 0.30 + Math.sin(t * 0.03) * 40 + scroll * 0.08;
    ctx.save();
    ctx.translate(sx, H * 0.42 - off);
    ctx.rotate(-0.32);
    var band = ctx.createLinearGradient(-W * 0.28, 0, W * 0.28, 0);
    band.addColorStop(0, 'rgba(255,196,130,0)');
    band.addColorStop(0.5, 'rgba(255,196,130,' + breathe.toFixed(4) + ')');
    band.addColorStop(1, 'rgba(255,196,130,0)');
    ctx.fillStyle = band;
    ctx.fillRect(-W * 0.28, -H * 0.75, W * 0.56, H * 1.5);
    ctx.restore();
  }

  /* ---- Plane 2: Strata contour lines, slowest plane ---- */
  function drawLines(t, scroll) {
    pointer.x += (pointer.tx - pointer.x) * 0.07;
    pointer.y += (pointer.ty - pointer.y) * 0.07;
    var px = pointer.x, py = pointer.y;
    var off = scroll * 0.06;

    if (px > -9000) {
      var glowR = Math.max(260, W * 0.2);
      var g = ctx.createRadialGradient(px, py, 0, px, py, glowR);
      g.addColorStop(0, 'rgba(232,206,168,0.16)');
      g.addColorStop(0.5, 'rgba(216,190,154,0.07)');
      g.addColorStop(1, 'rgba(216,190,154,0)');
      ctx.fillStyle = g;
      ctx.fillRect(px - glowR, py - glowR, glowR * 2, glowR * 2);
    }

    var sigma = Math.max(130, W * 0.1);
    var twoSigmaSq = 2 * sigma * sigma;
    var step = W < 640 ? 9 : 7;

    for (var i = 0; i < lines.length; i++) {
      var L = lines[i];
      var baseY = L.y - off;
      ctx.beginPath();
      for (var x = -10; x <= W + 10; x += step) {
        var y = baseY + field(x, L, t);
        var dx = x - px;
        var fall = Math.exp(-(dx * dx) / twoSigmaSq);
        if (fall > 0.01) {
          var dy = y - py;
          var bend = dy / (60 + Math.abs(dy));
          y += bend * fall * 60 * Math.exp(-Math.abs(dy) / 200);
        }
        if (x === -10) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      var dyLine = baseY - py;
      var glow = Math.exp(-(dyLine * dyLine) / (2 * 190 * 190));
      ctx.strokeStyle = L.accent ? L.gradAccent : L.grad;
      ctx.globalAlpha = Math.min(1, L.jitter * (0.7 + glow * 1.6));
      ctx.lineWidth = L.accent ? 1.5 : 1;
      ctx.stroke();
      ctx.globalAlpha = 1;
    }
  }

  /* ---- Plane 3: dust motes drifting like sunbeam dust ---- */
  function drawMotes(t, scroll, dt) {
    var px = pointer.x, py = pointer.y;
    var off = scroll * 0.14;
    var half = 32;

    for (var i = 0; i < motes.length; i++) {
      var m = motes[i];
      /* Slow sine drift, afternoon light pace */
      var wx = m.x + Math.sin(t * 0.07 * m.speed + m.phase) * 30 * m.depth;
      var wy = m.y + Math.cos(t * 0.05 * m.speed + m.phase * 1.7) * 24 * m.depth - off * m.depth;

      /* Scroll stir, damped by the stir value */
      wy += stir * 46 * m.depth;

      /* Cursor nudge, very low force */
      var dx = wx - px, dy = wy - py;
      var dist = Math.sqrt(dx * dx + dy * dy);
      var targetOX = 0, targetOY = 0;
      if (dist < 170 && dist > 1) {
        var push = (1 - dist / 170) * 7 * m.depth;
        targetOX = (dx / dist) * push;
        targetOY = (dy / dist) * push;
      }
      m.ox += (targetOX - m.ox) * 0.04;
      m.oy += (targetOY - m.oy) * 0.04;
      wx += m.ox; wy += m.oy;

      /* Wrap vertically within a margin so motes never vanish */
      if (wy < -40) wy += H + 80;
      if (wy > H + 40) wy -= H + 80;
      if (wx < -40) wx += W + 80;
      if (wx > W + 40) wx -= W + 80;

      var twinkle = 0.72 + 0.28 * Math.sin(t * 0.5 * m.speed + m.phase * 3);
      var size = m.r * m.depth * 7;
      ctx.globalAlpha = (0.05 + 0.055 * m.depth) * twinkle;
      ctx.drawImage(moteSprite, wx - size / 2, wy - size / 2, size, size);
    }
    ctx.globalAlpha = 1;
  }

  /* ---- Plane 4: whisper thin film grain ---- */
  function drawGrain() {
    if (!grainPattern) return;
    ctx.save();
    ctx.globalCompositeOperation = 'overlay';
    ctx.globalAlpha = 0.055;
    ctx.translate(rand(0, 128), rand(0, 128));
    ctx.fillStyle = grainPattern;
    ctx.fillRect(-128, -128, W + 256, H + 256);
    ctx.restore();
    ctx.globalAlpha = 1;
  }

  function draw(t) {
    scrollY = currentScroll();
    ctx.clearRect(0, 0, W, H);
    drawHaze(t, scrollY);
    drawLines(t, scrollY);
    drawMotes(t, scrollY, 0);
    if (grainOn()) drawGrain();
  }

  function frame(now) {
    if (!running) return;
    if (!lastT) lastT = now;
    var dt = Math.min((now - lastT) / 1000, 0.1);
    lastT = now;
    elapsed += dt;

    /* Damped scroll velocity stirs the dust, then settles */
    var s = currentScroll();
    var vel = dt > 0 ? (s - lastScrollY) / dt : 0;
    lastScrollY = s;
    stir += ((vel / 2400) - stir) * (1 - Math.pow(0.02, dt));
    if (Math.abs(stir) < 0.0005) stir = 0;
    stir = Math.max(-1.2, Math.min(1.2, stir));

    if (coarsePointer) {
      pointer.tx = W * (0.5 + 0.3 * Math.sin(elapsed * 0.11));
      pointer.ty = H * (0.46 + 0.26 * Math.sin(elapsed * 0.17 + 1.4));
    }
    draw(elapsed);
  }

  /* Single rAF loop, owned by the GSAP ticker when available */
  function loop(now) {
    frame(now);
    if (!reduceMotion) requestAnimationFrame(loop);
  }

  makeMoteSprite();
  resize();

  function handleResize() {
    resize();
    if (reduceMotion) {
      /* A resize wipes the canvas; repaint the single static frame */
      pointer.x = W * 0.62; pointer.y = H * 0.4;
      pointer.tx = pointer.x; pointer.ty = pointer.y;
      stir = 0;
      draw(8.0);
    }
  }
  window.addEventListener('resize', handleResize);

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) { running = false; }
    else {
      running = true;
      lastT = 0;
      if (!reduceMotion) requestAnimationFrame(loop);
    }
  });

  if (!coarsePointer && !reduceMotion) {
    window.addEventListener('pointermove', function (e) {
      pointer.tx = e.clientX;
      pointer.ty = e.clientY;
    });
    document.documentElement.addEventListener('mouseleave', function () {
      pointer.tx = -10000; pointer.ty = -10000;
    });
  }

  if (reduceMotion) {
    /* One composed static frame, then stop */
    pointer.x = W * 0.62; pointer.y = H * 0.4;
    pointer.tx = pointer.x; pointer.ty = pointer.y;
    stir = 0;
    draw(8.0);
  } else {
    if (hasGsap) { gsap.ticker.add(function () { frame(performance.now()); }); }
    else { requestAnimationFrame(loop); }
  }

  /* Screenshot helper: ?shot=mid lands on Projects */
  if (params.get('shot') === 'mid') {
    var target = document.querySelector('.projects');
    if (target) {
      if (lenis) lenis.scrollTo(target, { immediate: true, offset: -60 });
      else window.scrollTo(0, Math.max(0, target.offsetTop - 60));
    }
  }
})();
</script>
</body>
