<script>
(function () {
  'use strict';

  var params = new URLSearchParams(location.search);
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  var coarse = window.matchMedia('(pointer: coarse)').matches;
  var reduced = prefersReduced.matches || params.get('reduced') === '1';

  /* ================= DOM: reveals, accordions, motion toggle ================= */
  var motionToggle = document.getElementById('motion-toggle');

  function setMotionUI() {
    document.documentElement.classList.toggle('rm', reduced);
    if (motionToggle) {
      motionToggle.setAttribute('aria-pressed', reduced ? 'true' : 'false');
      motionToggle.textContent = reduced ? 'Restore motion' : 'Reduce motion';
    }
    if (reduced) {
      document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
    }
  }

  if (!reduced && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
    document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
  }

  document.querySelectorAll('.project-header, .company-header').forEach(function (button) {
    button.addEventListener('click', function () {
      var item = button.parentElement;
      var list = item.parentElement;
      var isOpen = item.classList.contains('open');
      list.querySelectorAll('.open').forEach(function (openItem) {
        openItem.classList.remove('open');
        openItem.querySelector('button').setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });

  /* ================= Drift canvas: one fixed 2D field =================
     Back to front: breathing glow masses, warm pointer disturbance,
     expanding tap ripples, drifting particles, film grain,
     and a vignette that deepens with scroll. No lines, no contours. */
  var canvas = document.getElementById('drift');
  var ctx = canvas.getContext('2d');
  var W = 0, H = 0, DPR = 1;
  var small = false;
  var particles = [], ripples = [];
  var sprite = null;
  var grainTile = null, grainPattern = null;

  var pointer = { x: -9999, y: -9999, tx: -9999, ty: -9999, lastMove: 0 };
  var lastScrollY = 0, progress = 0, stir = 0;
  var t = 0, lastT = 0, running = true, rafId = 0;

  function rand(a, b) { return a + Math.random() * (b - a); }
  function clamp(v, a, b) { return v < a ? a : (v > b ? b : v); }
  function rgba(c, a) { return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + a.toFixed(3) + ')'; }

  /* Desaturated glow masses: warm sand, cool slate, dim stone. No neon. */
  var BLOBS = [
    { bx: 0.70, by: 0.24, r: 0.46, c: [216, 198, 172], a: 0.20, breathe: 31, ph: 0.4, dx: 0.050, dy: 0.035, sx: 0.021, sy: 0.017 },
    { bx: 0.20, by: 0.60, r: 0.40, c: [148, 158, 172], a: 0.17, breathe: 41, ph: 2.2, dx: 0.045, dy: 0.050, sx: 0.016, sy: 0.020 },
    { bx: 0.55, by: 0.88, r: 0.48, c: [196, 176, 150], a: 0.15, breathe: 36, ph: 4.1, dx: 0.055, dy: 0.040, sx: 0.019, sy: 0.015 },
    { bx: 0.88, by: 0.66, r: 0.30, c: [170, 160, 146], a: 0.18, breathe: 27, ph: 1.3, dx: 0.040, dy: 0.045, sx: 0.024, sy: 0.018 },
    { bx: 0.34, by: 0.14, r: 0.27, c: [138, 150, 166], a: 0.16, breathe: 44, ph: 5.4, dx: 0.045, dy: 0.035, sx: 0.014, sy: 0.022 }
  ];

  function makeSprite() {
    var s = 64;
    sprite = document.createElement('canvas');
    sprite.width = s; sprite.height = s;
    var c = sprite.getContext('2d');
    var g = c.createRadialGradient(s / 2, s / 2, 0, s / 2, s / 2, s / 2);
    g.addColorStop(0, 'rgba(244,236,222,1)');
    g.addColorStop(0.4, 'rgba(240,230,212,0.40)');
    g.addColorStop(1, 'rgba(240,230,212,0)');
    c.fillStyle = g;
    c.fillRect(0, 0, s, s);
  }

  function makeGrain() {
    var s = 128;
    grainTile = document.createElement('canvas');
    grainTile.width = s; grainTile.height = s;
    var c = grainTile.getContext('2d');
    var img = c.createImageData(s, s);
    var d = img.data;
    for (var i = 0; i < d.length; i += 4) {
      var v = 108 + Math.random() * 40;
      d[i] = v; d[i + 1] = v; d[i + 2] = v; d[i + 3] = 255;
    }
    c.putImageData(img, 0, 0);
    grainPattern = ctx.createPattern(grainTile, 'repeat');
  }

  /* Slow, smooth flow field from layered sines. No structure drawn, only felt. */
  function flowAngle(x, y, tt) {
    return (
      Math.sin(x * 0.0018 + tt * 0.10) * 1.5 +
      Math.cos(y * 0.0022 - tt * 0.07) * 1.5 +
      Math.sin((x + y) * 0.0011 + tt * 0.05) * 0.8
    );
  }

  function buildParticles() {
    particles = [];
    var count = small ? 90 : 230;
    for (var i = 0; i < count; i++) {
      particles.push({
        x: rand(0, W), y: rand(0, H),
        depth: rand(0.25, 1),
        phase: rand(0, 6.2832),
        speed: rand(9, 22),
        size: rand(4, 11),
        warm: 0
      });
    }
  }

  function spawnRipple(x, y) {
    if (ripples.length > 6) ripples.shift();
    ripples.push({ x: x, y: y, r: 0, age: 0, life: 3.0, maxR: Math.max(W, H) * 0.55, strength: 1 });
  }

  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 1.5);
    W = window.innerWidth;
    H = window.innerHeight;
    small = Math.min(W, H) < 700 || coarse;
    canvas.width = Math.max(1, Math.round(W * DPR));
    canvas.height = Math.max(1, Math.round(H * DPR));
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    buildParticles();
    if (!reduced) makeGrain();
  }

  function drawBlobs(tt) {
    ctx.globalCompositeOperation = 'lighter';
    for (var i = 0; i < BLOBS.length; i++) {
      var b = BLOBS[i];
      var x = (b.bx + Math.sin(tt * b.sx + b.ph) * b.dx) * W;
      var y = (b.by + Math.cos(tt * b.sy + b.ph * 1.7) * b.dy) * H;
      var rad = b.r * Math.max(W, H) * (1 + 0.10 * Math.sin((tt * 6.2832) / b.breathe + b.ph));
      var g = ctx.createRadialGradient(x, y, 0, x, y, rad);
      g.addColorStop(0, rgba(b.c, b.a));
      g.addColorStop(0.5, rgba(b.c, b.a * 0.55));
      g.addColorStop(1, rgba(b.c, 0));
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(x, y, rad, 0, 6.2832);
      ctx.fill();
    }
    ctx.globalCompositeOperation = 'source-over';
  }

  function drawPointerGlow() {
    if (pointer.x < -9000) return;
    var r = Math.max(200, Math.min(W, H) * 0.24);
    var g = ctx.createRadialGradient(pointer.x, pointer.y, 0, pointer.x, pointer.y, r);
    g.addColorStop(0, 'rgba(242,231,211,0.10)');
    g.addColorStop(0.55, 'rgba(226,206,178,0.045)');
    g.addColorStop(1, 'rgba(226,206,178,0)');
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(pointer.x, pointer.y, r, 0, 6.2832);
    ctx.fill();
  }

  function drawRipples(dt) {
    for (var i = ripples.length - 1; i >= 0; i--) {
      var r = ripples[i];
      r.age += dt;
      var k = r.age / r.life;
      if (k >= 1) { ripples.splice(i, 1); continue; }
      var rr = r.maxR * (1 - Math.pow(1 - k, 3));
      r.r = rr;
      r.strength = 1 - k;
      var a = 0.16 * (1 - k);
      ctx.strokeStyle = 'rgba(242,231,211,' + a.toFixed(3) + ')';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(r.x, r.y, Math.max(1, rr), 0, 6.2832);
      ctx.stroke();
    }
  }

  function drawParticles(tt, dt) {
    var stirBoost = 1 + Math.min(3, Math.abs(stir) * 4);
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      var ang = flowAngle(p.x, p.y, tt);
      var sp = p.speed * stirBoost * (1 + 0.25 * Math.sin(tt * 0.4 + p.phase));
      p.x += Math.cos(ang) * sp * dt;
      p.y += Math.sin(ang) * sp * dt;

      /* Warm disturbance at the pointer: nudges and brightens nearby dust */
      var dx = p.x - pointer.x, dy = p.y - pointer.y;
      var d = Math.sqrt(dx * dx + dy * dy);
      var warmTarget = 0;
      if (d < 300 && d > 1) {
        var push = (1 - d / 300) * 30 * dt;
        p.x += (dx / d) * push;
        p.y += (dy / d) * push;
        warmTarget = 1 - d / 300;
      }
      p.warm += (warmTarget - p.warm) * (1 - Math.pow(0.05, dt));

      /* Tap ripples push the dust outward as they pass */
      for (var j = 0; j < ripples.length; j++) {
        var r = ripples[j];
        var rx = p.x - r.x, ry = p.y - r.y;
        var rd = Math.sqrt(rx * rx + ry * ry);
        var band = Math.abs(rd - r.r);
        if (band < 90 && rd > 1) {
          var rp = (1 - band / 90) * r.strength * 130 * dt;
          p.x += (rx / rd) * rp;
          p.y += (ry / rd) * rp;
        }
      }

      var m = 30;
      if (p.x < -m) p.x += W + m * 2;
      if (p.x > W + m) p.x -= W + m * 2;
      if (p.y < -m) p.y += H + m * 2;
      if (p.y > H + m) p.y -= H + m * 2;

      var tw = 0.7 + 0.3 * Math.sin(tt * 0.6 + p.phase * 3);
      var size = p.size * (0.6 + p.depth * 0.7) * (1 + p.warm * 0.5);
      ctx.globalAlpha = Math.min(0.55, (0.07 + 0.20 * p.depth) * tw * (1 + p.warm * 1.1));
      ctx.drawImage(sprite, p.x - size / 2, p.y - size / 2, size, size);
    }
    ctx.globalAlpha = 1;
  }

  function drawGrain() {
    if (!grainPattern) return;
    ctx.save();
    ctx.globalCompositeOperation = 'overlay';
    ctx.globalAlpha = 0.05;
    ctx.translate(rand(0, 128), rand(0, 128));
    ctx.fillStyle = grainPattern;
    ctx.fillRect(-128, -128, W + 256, H + 256);
    ctx.restore();
    ctx.globalAlpha = 1;
  }

  function drawVignette() {
    var vig = clamp(0.30 + 0.32 * progress + Math.min(0.16, Math.abs(stir) * 0.5), 0, 0.62);
    var cx = W / 2, cy = H / 2;
    var g = ctx.createRadialGradient(cx, cy, Math.min(W, H) * 0.30, cx, cy, Math.max(W, H) * 0.74);
    g.addColorStop(0, 'rgba(11,12,17,0)');
    g.addColorStop(1, 'rgba(11,12,17,' + vig.toFixed(3) + ')');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, H);
  }

  function frame(now) {
    if (!running) return;
    if (!lastT) lastT = now;
    var dt = Math.min((now - lastT) / 1000, 0.1);
    lastT = now;
    t += dt;

    /* Scroll: progress deepens the vignette, velocity stirs the field */
    var s = window.scrollY || window.pageYOffset || 0;
    var maxScroll = Math.max(1, document.documentElement.scrollHeight - H);
    progress = clamp(s / maxScroll, 0, 1);
    var vel = dt > 0 ? (s - lastScrollY) / dt : 0;
    lastScrollY = s;
    stir += ((vel / 2600) - stir) * (1 - Math.pow(0.02, dt));
    stir = clamp(stir, -1.5, 1.5);
    if (Math.abs(stir) < 0.0005) stir = 0;

    /* Pointer easing; an idle pointer drifts on its own slow orbit */
    if ((now - pointer.lastMove) > 5000) {
      pointer.tx = W * (0.5 + 0.32 * Math.sin(t * 0.09));
      pointer.ty = H * (0.44 + 0.28 * Math.sin(t * 0.13 + 1.7));
    }
    var ease = 1 - Math.pow(0.08, dt);
    pointer.x += (pointer.tx - pointer.x) * ease;
    pointer.y += (pointer.ty - pointer.y) * ease;

    ctx.fillStyle = '#0b0c11';
    ctx.fillRect(0, 0, W, H);
    drawBlobs(t);
    drawPointerGlow();
    drawRipples(dt);
    drawParticles(t, dt);
    drawGrain();
    drawVignette();
  }

  function loop(now) {
    frame(now);
    if (running && !reduced) rafId = requestAnimationFrame(loop);
  }

  function startLoop() {
    running = true;
    lastT = 0;
    cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(loop);
  }

  function stopLoop() {
    running = false;
    cancelAnimationFrame(rafId);
  }

  function staticFrame() {
    /* One composed frame for reduced motion */
    var keep = t;
    t = 8.0;
    pointer.x = W * 0.62; pointer.y = H * 0.40;
    pointer.tx = pointer.x; pointer.ty = pointer.y;
    stir = 0; progress = 0;
    ripples = [];
    ctx.fillStyle = '#0b0c11';
    ctx.fillRect(0, 0, W, H);
    drawBlobs(t);
    drawPointerGlow();
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      var size = p.size * (0.6 + p.depth * 0.7);
      ctx.globalAlpha = Math.min(0.55, 0.07 + 0.20 * p.depth);
      ctx.drawImage(sprite, p.x - size / 2, p.y - size / 2, size, size);
    }
    ctx.globalAlpha = 1;
    drawGrain();
    drawVignette();
    t = keep;
  }

  /* Pointer and touch share one path; pointer events cover touchmove natively */
  window.addEventListener('pointermove', function (e) {
    if (reduced) return;
    pointer.tx = e.clientX;
    pointer.ty = e.clientY;
    pointer.lastMove = performance.now();
  }, { passive: true });

  /* Taps (mouse or touch) send a slow ripple outward */
  var downX = 0, downY = 0, downTime = 0, hasDown = false;
  window.addEventListener('pointerdown', function (e) {
    downX = e.clientX; downY = e.clientY;
    downTime = performance.now();
    hasDown = true;
  }, { passive: true });
  window.addEventListener('pointerup', function (e) {
    if (reduced || !hasDown) return;
    hasDown = false;
    var moved = Math.sqrt(Math.pow(e.clientX - downX, 2) + Math.pow(e.clientY - downY, 2));
    if ((performance.now() - downTime) < 350 && moved < 14) spawnRipple(e.clientX, e.clientY);
  }, { passive: true });

  document.documentElement.addEventListener('mouseleave', function () {
    pointer.tx = -9999; pointer.ty = -9999;
  });

  var resizeTimer = 0;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      resize();
      if (reduced) staticFrame();
    }, 150);
  });

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) { stopLoop(); }
    else if (!reduced) { startLoop(); }
  });

  if (motionToggle) {
    motionToggle.addEventListener('click', function () {
      reduced = !reduced;
      setMotionUI();
      if (reduced) { stopLoop(); staticFrame(); }
      else { makeGrain(); startLoop(); }
    });
  }
  if (prefersReduced.addEventListener) {
    prefersReduced.addEventListener('change', function (e) {
      if (e.matches && !reduced) {
        reduced = true;
        setMotionUI();
        stopLoop();
        staticFrame();
      }
    });
  }

  makeSprite();
  resize();
  setMotionUI();

  if (reduced) {
    staticFrame();
  } else {
    pointer.x = W * 0.62; pointer.y = H * 0.40;
    pointer.tx = pointer.x; pointer.ty = pointer.y;
    pointer.lastMove = performance.now();
    startLoop();
  }

  /* Screenshot helper: ?shot=mid lands on Projects */
  if (params.get('shot') === 'mid') {
    var target = document.querySelector('.projects');
    if (target) window.scrollTo(0, Math.max(0, target.offsetTop - 60));
  }
})();
</script>
</body>
</html>
