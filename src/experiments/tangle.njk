  .rm .reveal { opacity: 1; transform: none; filter: none; }
  .rm .button, .rm .button:hover { transition: none; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; filter: none; transition: none; }
    .project-details, .company-details { transition: none; }
  }
</style>
