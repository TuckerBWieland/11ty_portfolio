<script>
(function () {
  'use strict';

  var params = new URLSearchParams(location.search);
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  var coarse = window.matchMedia('(pointer: coarse)').matches;
  var reduced = prefersReduced.matches || params.get('reduced') === '1';

  /* ================= DOM: reveals, accordions, motion toggle ================= */
  var motionToggle = document.getElementById('motion-toggle');

  function setMotionUI() {
    document.documentElement.classList.toggle('rm', reduced);
    if (motionToggle) {
      motionToggle.setAttribute('aria-pressed', reduced ? 'true' : 'false');
      motionToggle.textContent = reduced ? 'Restore motion' : 'Reduce motion';
    }
    if (reduced) {
      document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
    }
  }

  if (!reduced && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
    document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
  }

  document.querySelectorAll('.project-header, .company-header').forEach(function (button) {
    button.addEventListener('click', function () {
      var item = button.parentElement;
      var list = item.parentElement;
      var isOpen = item.classList.contains('open');
      list.querySelectorAll('.open').forEach(function (openItem) {
        openItem.classList.remove('open');
        openItem.querySelector('button').setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });

  /* ================= Tangle canvas: knot to weave =================
     N threads, each with two states: a chaotic knot (a seeded ball of yarn
     in the hero) and an ordered state (a woven warp and weft lattice that
     registers to the real card rows: warp threads sit on row dividers, weft
     threads frame the content column). Scroll progress, smoothed, drives
     per-thread interpolation, staggered so threads resolve one after
     another. The order travels along each thread like a hand pulling it
     taut. Pointer and taps gently disturb the field. */
  var canvas = document.getElementById('tangle');
  var ctx = canvas.getContext('2d');
  var W = 0, H = 0, DPR = 1;
  var coarseMode = false;
  var threads = [];
  var ripples = [];
  var grainPattern = null;

  var pointer = { x: -9999, y: -9999, tx: -9999, ty: -9999, lastMove: 0 };
  var lastScrollY = 0, progress = 0, stir = 0;
  var t = 0, lastT = 0, running = true, rafId = 0;

  function mulberry32(a) {
    return function () {
      a |= 0; a = a + 0x6D2B79F5 | 0;
      var b = Math.imul(a ^ a >>> 15, 1 | a);
      b = b + Math.imul(b ^ b >>> 7, 61 | b) ^ b;
      return ((b ^ b >>> 14) >>> 0) / 4294967296;
    };
  }
  function clamp(v, a, b) { return v < a ? a : (v > b ? b : v); }
  function lerp(a, b, k) { return a + (b - a) * k; }
  function smootherstep(x) {
    x = clamp(x, 0, 1);
    return x * x * x * (x * (x * 6 - 15) + 10);
  }

  /* Live content layout: the ordered lattice registers to the real card
     rows. Dividers are the viewport Y of every project/experience row edge;
     warp threads snap to them so lattice lines continue the card borders
     across the full width. Weft rails frame the content column. */
  var layout = { dividers: [] };
  function measureLayout() {
    var items = document.querySelectorAll('.project-item, .company-item');
    var divs = [];
    for (var n = 0; n < items.length; n++) {
      var r = items[n].getBoundingClientRect();
      divs.push(r.top);
      if (n === items.length - 1) divs.push(r.bottom);
    }
    layout.dividers = divs;
  }
  function edgeFade(v, max) {
    var m = 160;
    var d = v < 0 ? -v : (v > max ? v - max : 0);
    return clamp(1 - d / m, 0, 1);
  }

  function buildThreads() {
    threads = [];
    var count = coarseMode ? 30 : 54;
    var M = coarseMode ? 46 : 64;
    var s = Math.min(W, H);
    var cx = W / 2, cy = H * 0.5;
    var ballR = s * 0.36;
    var horiz = Math.ceil(count / 2);
    var vert = count - horiz;
    var margin = s * 0.08;
    /* Content column: weft rails will frame it, warp threads will snap to
       its row dividers, so the finished weave and the cards read as one. */
    var colRect = document.querySelector('.projects').getBoundingClientRect();
    var colL = colRect.left, colR = colRect.right;

    for (var i = 0; i < count; i++) {
      var rng = mulberry32(1000 + i * 7919);

      /* Chaotic state: a ball of yarn, constrained random walk with swirl */
      var cxs = new Float32Array(M), cys = new Float32Array(M);
      var x = cx + (rng() - 0.5) * ballR;
      var y = cy + (rng() - 0.5) * ballR;
      var ang = rng() * Math.PI * 2;
      var swirl = (rng() - 0.5) * 2;
      var step = ballR * 0.085;
      for (var j = 0; j < M; j++) {
        cxs[j] = x; cys[j] = y;
        ang += (rng() - 0.5) * 1.9 + swirl * 0.35;
        var nx = x + Math.cos(ang) * step;
        var ny = y + Math.sin(ang) * step * 0.9;
        var dx = nx - cx, dy = ny - cy;
        var d = Math.sqrt(dx * dx + dy * dy);
        if (d > ballR) {
          var ux = dx / d, uy = dy / d;
          nx = cx + ux * (ballR - step * 0.5);
          ny = cy + uy * (ballR - step * 0.5);
          ang = Math.atan2(-uy, -ux) + (rng() - 0.5) * 1.2;
        }
        x = nx; y = ny;
      }

      /* Ordered state: warp threads register to card-row dividers (their
         exact Y is resolved live per frame); weft threads become rails,
         two pinned to the content column edges, the rest routed around it. */
      var kind = i < horiz ? 0 : 1;
      var di = 0, jit = 0, weftX = 0;
      if (kind === 0) {
        di = horiz <= 1 ? 0 : i / (horiz - 1);
        jit = (rng() - 0.5) * 6;
      } else {
        var vi = i - horiz;
        if (vi === 0) { weftX = colL; }
        else if (vi === 1) { weftX = colR; }
        else {
          var slots = vert - 2;
          var si = vi - 2;
          weftX = lerp(-margin, W + margin, slots <= 1 ? 0.5 : si / (slots - 1));
          if (weftX > colL - 34 && weftX < colR + 34) {
            weftX = weftX < (colL + colR) / 2 ? colL - 34 : colR + 34;
          }
        }
      }

      threads.push({
        kind: kind, di: di, jit: jit, weftX: weftX,
        cx: cxs, cy: cys, M: M,
        start: rng() * 0.52,
        span: 0.48,
        sweep: 0.5 + rng() * 0.4,
        flip: rng() < 0.5 ? 0 : 1,
        phase: rng() * Math.PI * 2,
        wob: 0.6 + rng() * 0.8,
        alpha: 0.20 + rng() * 0.08,
        bright: rng() < 0.18
      });
    }
  }

  function spawnRipple(x, y) {
    if (ripples.length > 6) ripples.shift();
    ripples.push({ x: x, y: y, r: 0, age: 0, life: 2.6, maxR: Math.max(W, H) * 0.5, strength: 1 });
  }

  function makeGrain() {
    var s = 128;
    var tile = document.createElement('canvas');
    tile.width = s; tile.height = s;
    var c = tile.getContext('2d');
    var img = c.createImageData(s, s);
    var dd = img.data;
    for (var i = 0; i < dd.length; i += 4) {
      var v = 108 + Math.random() * 40;
      dd[i] = v; dd[i + 1] = v; dd[i + 2] = v; dd[i + 3] = 255;
    }
    c.putImageData(img, 0, 0);
    grainPattern = ctx.createPattern(tile, 'repeat');
  }

  function drawHalo() {
    var s = Math.min(W, H);
    var a = (1 - progress) * 0.055;
    if (a <= 0.001) return;
    ctx.globalCompositeOperation = 'lighter';
    var g = ctx.createRadialGradient(W / 2, H * 0.5, 0, W / 2, H * 0.5, s * 0.55);
    g.addColorStop(0, 'rgba(216,198,172,' + a.toFixed(3) + ')');
    g.addColorStop(1, 'rgba(216,198,172,0)');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, H);
    ctx.globalCompositeOperation = 'source-over';
  }

  function drawThreads() {
    var PR = 200, PR2 = PR * PR;
    var stirAmp = Math.min(1.5, Math.abs(stir) * 3);
    var divs = layout.dividers;
    var nDiv = divs.length;
    var margin = Math.min(W, H) * 0.08;
    for (var i = 0; i < threads.length; i++) {
      var th = threads[i];
      var tp = smootherstep((progress - th.start) / th.span);
      /* Ordered anchor, resolved live: warp threads sit on card-row
         dividers so lattice lines continue the card borders; weft threads
         sit on the column rails. */
      var ax, ay;
      if (th.kind === 0) {
        ax = W / 2;
        ay = nDiv ? divs[Math.round(th.di * (nDiv - 1))] + th.jit : H * th.di;
      } else {
        ax = th.weftX;
        ay = H / 2;
      }
      var a = lerp(th.alpha, 0.55, tp);
      a *= 0.25 + 0.75 * Math.min(edgeFade(ax, W), edgeFade(ay, H));
      ctx.strokeStyle = th.bright
        ? 'rgba(240,228,202,' + a.toFixed(3) + ')'
        : 'rgba(214,196,164,' + a.toFixed(3) + ')';
      ctx.lineWidth = 1;
      ctx.beginPath();
      var M = th.M;
      for (var j = 0; j < M; j++) {
        var u = j / (M - 1);
        var su = th.flip ? 1 - u : u;
        /* Order travels along the thread, like pulling it taut */
        var wj = smootherstep(tp * (1 + th.sweep) - th.sweep * su);
        var exx, eyy;
        if (th.kind === 0) { exx = lerp(-margin, W + margin, u); eyy = ay; }
        else { exx = ax; eyy = lerp(-margin, H + margin, u); }
        var x = lerp(th.cx[j], exx, wj);
        var y = lerp(th.cy[j], eyy, wj);
        /* Quiver: the thread keeps a memory of the tangle, decays into order */
        var qa = (1 - wj) * 5 * th.wob + 0.45 + stirAmp;
        x += Math.sin(t * 1.3 + th.phase + j * 0.55) * qa;
        y += Math.cos(t * 1.1 + th.phase * 1.3 + j * 0.42) * qa;
        /* Pointer gently pushes nearby thread */
        var pdx = x - pointer.x, pdy = y - pointer.y;
        var pd = pdx * pdx + pdy * pdy;
        if (pd < PR2 && pd > 4) {
          var pdd = Math.sqrt(pd);
          var push = (1 - pdd / PR);
          push = push * push * 30;
          x += (pdx / pdd) * push;
          y += (pdy / pdd) * push;
        }
        /* Tap ripples shove the weave as they pass */
        for (var r = 0; r < ripples.length; r++) {
          var rp = ripples[r];
          var rdx = x - rp.x, rdy = y - rp.y;
          var rdd = Math.sqrt(rdx * rdx + rdy * rdy) || 1;
          var band = Math.abs(rdd - rp.r);
          if (band < 110) {
            var imp = (1 - band / 110) * rp.strength * 22;
            x += (rdx / rdd) * imp;
            y += (rdy / rdd) * imp;
          }
        }
        if (j === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.stroke();
    }
  }

  function drawRipples(dt) {
    for (var i = ripples.length - 1; i >= 0; i--) {
      var r = ripples[i];
      r.age += dt;
      var k = r.age / r.life;
      if (k >= 1) { ripples.splice(i, 1); continue; }
      r.r = r.maxR * (1 - Math.pow(1 - k, 3));
      r.strength = 1 - k;
      ctx.strokeStyle = 'rgba(242,231,211,' + (0.10 * (1 - k)).toFixed(3) + ')';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(r.x, r.y, Math.max(1, r.r), 0, 6.2832);
      ctx.stroke();
    }
  }

  function drawGrain() {
    if (!grainPattern) return;
    ctx.save();
    ctx.globalCompositeOperation = 'overlay';
    ctx.globalAlpha = 0.04;
    ctx.translate((t * 37) % 128, (t * 23) % 128);
    ctx.fillStyle = grainPattern;
    ctx.fillRect(-128, -128, W + 256, H + 256);
    ctx.restore();
    ctx.globalAlpha = 1;
  }

  function drawVignette() {
    var vig = clamp(0.30 + 0.32 * progress + Math.min(0.16, Math.abs(stir) * 0.5), 0, 0.62);
    var g = ctx.createRadialGradient(W / 2, H / 2, Math.min(W, H) * 0.30, W / 2, H / 2, Math.max(W, H) * 0.74);
    g.addColorStop(0, 'rgba(11,12,17,0)');
    g.addColorStop(1, 'rgba(11,12,17,' + vig.toFixed(3) + ')');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, H);
  }

  function draw(dt) {
    measureLayout();
    ctx.fillStyle = '#0b0c11';
    ctx.fillRect(0, 0, W, H);
    drawHalo();
    drawThreads();
    drawRipples(dt);
    drawGrain();
    drawVignette();
  }

  function targetProgress() {
    var s = window.scrollY || window.pageYOffset || 0;
    var maxScroll = Math.max(1, document.documentElement.scrollHeight - H);
    return clamp(s / maxScroll, 0, 1);
  }

  function frame(now) {
    if (!running) return;
    if (!lastT) lastT = now;
    var dt = Math.min((now - lastT) / 1000, 0.1);
    lastT = now;
    t += dt;

    var s = window.scrollY || window.pageYOffset || 0;
    /* Smooth the scroll-to-progress mapping: the weave eases toward the
       scroll target instead of snapping to it. Frame-rate independent. */
    progress += (targetProgress() - progress) * (1 - Math.pow(0.002, dt));
    var vel = dt > 0 ? (s - lastScrollY) / dt : 0;
    lastScrollY = s;
    stir += ((vel / 2600) - stir) * (1 - Math.pow(0.02, dt));
    stir = clamp(stir, -1.5, 1.5);
    if (Math.abs(stir) < 0.0005) stir = 0;

    /* An idle pointer drifts on its own slow orbit, dimpling the weave */
    if ((now - pointer.lastMove) > 5000) {
      pointer.tx = W * (0.5 + 0.32 * Math.sin(t * 0.09));
      pointer.ty = H * (0.44 + 0.28 * Math.sin(t * 0.13 + 1.7));
    }
    var ease = 1 - Math.pow(0.08, dt);
    pointer.x += (pointer.tx - pointer.x) * ease;
    pointer.y += (pointer.ty - pointer.y) * ease;

    draw(dt);
  }

  function loop(now) {
    frame(now);
    if (running && !reduced) rafId = requestAnimationFrame(loop);
  }

  function startLoop() {
    running = true;
    lastT = 0;
    cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(loop);
  }

  function stopLoop() {
    running = false;
    cancelAnimationFrame(rafId);
  }

  /* One frozen composition for reduced motion. Scroll still drives the
     transformation, but only re rendered once the page settles. */
  function renderStatic() {
    progress = targetProgress();
    t = 4.2;
    pointer.x = -9999; pointer.y = -9999;
    pointer.tx = -9999; pointer.ty = -9999;
    ripples = [];
    stir = 0;
    draw(0);
  }

  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 1.5);
    W = window.innerWidth;
    H = window.innerHeight;
    coarseMode = Math.min(W, H) < 700 || coarse;
    canvas.width = Math.max(1, Math.round(W * DPR));
    canvas.height = Math.max(1, Math.round(H * DPR));
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    buildThreads();
  }

  /* Pointer and touch share one path; pointer events cover touchmove natively */
  window.addEventListener('pointermove', function (e) {
    if (reduced) return;
    pointer.tx = e.clientX;
    pointer.ty = e.clientY;
    pointer.lastMove = performance.now();
  }, { passive: true });

  /* Taps send a slow ripple through the weave */
  var downX = 0, downY = 0, downTime = 0, hasDown = false;
  window.addEventListener('pointerdown', function (e) {
    downX = e.clientX; downY = e.clientY;
    downTime = performance.now();
    hasDown = true;
  }, { passive: true });
  window.addEventListener('pointerup', function (e) {
    if (reduced || !hasDown) return;
    hasDown = false;
    var moved = Math.sqrt(Math.pow(e.clientX - downX, 2) + Math.pow(e.clientY - downY, 2));
    if ((performance.now() - downTime) < 350 && moved < 14) spawnRipple(e.clientX, e.clientY);
  }, { passive: true });

  document.documentElement.addEventListener('mouseleave', function () {
    pointer.tx = -9999; pointer.ty = -9999;
  });

  var resizeTimer = 0;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      resize();
      if (reduced) renderStatic();
    }, 150);
  });

  var scrollTimer = 0;
  window.addEventListener('scroll', function () {
    if (!reduced) return;
    clearTimeout(scrollTimer);
    scrollTimer = setTimeout(renderStatic, 250);
  }, { passive: true });

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) { stopLoop(); }
    else if (!reduced) { startLoop(); }
  });

  if (motionToggle) {
    motionToggle.addEventListener('click', function () {
      reduced = !reduced;
      setMotionUI();
      if (reduced) { stopLoop(); renderStatic(); }
      else { makeGrain(); startLoop(); }
    });
  }
  if (prefersReduced.addEventListener) {
    prefersReduced.addEventListener('change', function (e) {
      if (e.matches && !reduced) {
        reduced = true;
        setMotionUI();
        stopLoop();
        renderStatic();
      }
    });
  }

  makeGrain();
  resize();
  setMotionUI();

  if (reduced) {
    renderStatic();
  } else {
    pointer.x = W * 0.62; pointer.y = H * 0.40;
    pointer.tx = pointer.x; pointer.ty = pointer.y;
    pointer.lastMove = performance.now();
    startLoop();
  }

  /* Screenshot helper: ?shot=mid lands on Projects */
  if (params.get('shot') === 'mid') {
    var target = document.querySelector('.projects');
    if (target) window.scrollTo(0, Math.max(0, target.offsetTop - 60));
  }
})();
</script>
</body>
</html>
