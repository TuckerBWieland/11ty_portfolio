<style>
  @font-face {
    font-family: 'IBM Plex Mono';
    font-weight: 400;
    font-style: normal;
    font-display: optional;
    src: url('/assets/fonts/ibm-plex-mono-latin-400-normal.woff2') format('woff2');
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    font-weight: 700;
    font-style: normal;
    font-display: optional;
    src: url('/assets/fonts/ibm-plex-mono-latin-700-normal.woff2') format('woff2');
  }
  :root {
    --bg: #0b0c11;
    --ink: #ffffff;
    --ink-2: rgb(255 255 255 / 55%);
    --ink-3: rgb(255 255 255 / 32%);
    --line: rgb(255 255 255 / 10%);
    --warm: #f2e7d3;
    --warm-dim: rgb(242 231 211 / 70%);
  }
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  ::selection { background: #f2efe8; color: #101218; }
  a:focus-visible, button:focus-visible {
    outline: 2px solid #f2efe8; outline-offset: 3px; border-radius: 2px;
  }

  /* Fixed tangle canvas, behind everything */
  #tangle {
    position: fixed; inset: 0; width: 100%; height: 100%;
    z-index: 0; pointer-events: none; display: block;
  }
  /* Legibility: edges fall off, and a soft shadow sits behind the text column */
  .veil {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background: radial-gradient(120% 90% at 50% 40%, transparent 52%, rgb(11 12 17 / 46%) 100%);
  }
  .veil-core {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background: radial-gradient(58% 46% at 50% 46%, rgb(11 12 17 / 42%), transparent 70%);
  }

  .page { position: relative; z-index: 1; }

  /* Reduce motion toggle: small, visible, always available */
  .motion-toggle {
    position: fixed; right: 16px; bottom: 16px; z-index: 40;
    padding: 10px 18px; border-radius: 999px;
    background: rgb(11 12 17 / 72%); color: var(--ink-2);
    border: 1px solid rgb(255 255 255 / 18%);
    font-family: inherit; font-size: 0.75rem; cursor: pointer;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    transition: color .3s ease, border-color .3s ease;
  }
  .motion-toggle:hover { color: var(--ink); border-color: rgb(255 255 255 / 38%); }

  /* Nav */
  .site-nav {
    position: absolute; top: 0; left: 0; right: 0; z-index: 20;
    display: flex; align-items: center; justify-content: space-between;
    max-width: 800px; margin: 0 auto; padding: 20px;
  }
  .site-nav-name { color: var(--ink); text-decoration: none; font-weight: 700; font-size: 0.875rem; }
  .site-nav-links { display: flex; align-items: center; gap: 20px; }
  .site-nav-link {
    color: var(--ink-2); text-decoration: none; font-size: 0.875rem;
    transition: color .3s ease;
  }
  .site-nav-link:hover { color: var(--ink); }

  /* Sections */
  section { padding: 0 20px; max-width: 720px; margin: 0 auto; }
  .hero { min-height: 92svh; display: flex; align-items: center; padding-top: 120px; }
  .about, .projects, .experience, .contact { padding-top: 18vh; padding-bottom: 6vh; }
  .contact { padding-bottom: 22vh; }

  .hero-name {
    font-size: clamp(2.6rem, 8vw, 4.4rem);
    font-weight: 700; letter-spacing: -0.02em; line-height: 1.05;
    color: var(--ink);
  }
  .hero-note { margin-top: 1.1rem; color: var(--ink-2); font-size: 0.95rem; max-width: 46ch; }
  .hero-actions { display: flex; gap: 12px; margin-top: 2rem; flex-wrap: wrap; }

  .button {
    display: inline-block; padding: 12px 22px; border-radius: 999px;
    background: var(--warm); color: #101218; text-decoration: none;
    font-family: inherit; font-size: 0.875rem; font-weight: 700;
    transition: transform .35s ease, opacity .35s ease;
  }
  .button:hover { transform: translateY(-1px); opacity: .92; }
  .button-ghost {
    background: transparent; color: var(--ink);
    border: 1px solid rgb(255 255 255 / 28%);
  }
  .button-ghost:hover { border-color: rgb(255 255 255 / 55%); opacity: 1; }

  .section-title {
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--ink-3);
    margin-bottom: 1.6rem;
  }
  .about-body { color: var(--ink-2); font-size: 0.95rem; max-width: 62ch; }
  .about-body p { margin-bottom: 1rem; }

  /* Scroll reveals: slow settle, disabled under reduced motion */
  .reveal {
    opacity: 0; transform: translateY(14px); filter: blur(6px);
    transition: opacity .9s ease, transform .9s ease, filter .9s ease;
  }
  .reveal.in { opacity: 1; transform: none; filter: none; }

  /* Accordions */
  .project-list, .company-list { list-style: none; }
  .project-item, .company-item {
    position: relative; overflow: hidden;
    border-top: 1px solid rgb(214 196 164 / 26%);
  }
  .project-item:last-child, .company-item:last-child { border-bottom: 1px solid rgb(214 196 164 / 26%); }
  .project-header, .company-header {
    width: 100%; display: flex; align-items: baseline; justify-content: space-between;
    gap: 16px; padding: 20px 4px; background: none; border: 0; cursor: pointer;
    font-family: inherit; color: inherit; text-align: left;
  }
  .project-name, .company-name { font-size: 1.02rem; font-weight: 700; color: var(--ink); }
  .project-meta, .company-meta {
    display: flex; align-items: center; gap: 12px; flex-shrink: 0;
