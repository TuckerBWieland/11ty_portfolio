  .project-company, .company-role { font-size: 0.78rem; color: var(--ink-3); }
  .toggle-icon { width: 16px; height: 16px; color: var(--ink-2); transition: transform .45s ease; }
  .open .toggle-icon { transform: rotate(180deg); }

  .project-details, .company-details {
    display: grid; grid-template-rows: 0fr;
    transition: grid-template-rows .55s cubic-bezier(.22, 1, .36, 1);
  }
  .open .project-details, .open .company-details { grid-template-rows: 1fr; }
  .details-inner { overflow: hidden; }
  .project-bullets, .company-bullets {
