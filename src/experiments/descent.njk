<title>Tucker Wieland, Descent</title>
<meta name="description" content="An experiment in descent. Scroll down; the page sinks and the light stays where it is.">
<style>
  @font-face {
    font-family: 'IBM Plex Mono';
    font-weight: 400;
    font-style: normal;
    font-display: optional;
    src: url('/assets/fonts/ibm-plex-mono-latin-400-normal.woff2') format('woff2');
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    font-weight: 700;
    font-style: normal;
    font-display: optional;
    src: url('/assets/fonts/ibm-plex-mono-latin-700-normal.woff2') format('woff2');
  }
  :root {
    --bg: #0b0c11;
    --ink: #ffffff;
    --ink-2: rgb(255 255 255 / 55%);
    --ink-3: rgb(255 255 255 / 32%);
    --line: rgb(255 255 255 / 10%);
    --warm: #f2e7d3;
    --warm-dim: rgb(242 231 211 / 70%);
  }
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  ::selection { background: #f2efe8; color: #101218; }
  a:focus-visible, button:focus-visible {
    outline: 2px solid #f2efe8; outline-offset: 3px; border-radius: 2px;
  }

  /* ============ Fixed depth stack, back to front ============ */
  .glow-warm {
    position: fixed; left: 0; right: 0; top: -10vh; height: 80vh;
    z-index: 0; pointer-events: none; opacity: 0.5;
    background: radial-gradient(62% 58% at 50% 32%, rgb(242 231 211 / 0.10) 0%, rgb(242 231 211 / 0) 70%);
    will-change: transform, opacity;
  }
  .moon {
    position: fixed; left: 50%; top: 26vh;
    width: min(210px, 44vw); aspect-ratio: 1; border-radius: 50%;
    transform: translate(-50%, -50%);
    z-index: 0; pointer-events: none;
    background: radial-gradient(circle at 42% 38%,
      #f4ecdd 0%, #e7dac3 46%, #cabd9f 76%, rgb(202 189 159 / 0) 100%);
    box-shadow:
      0 0 90px 34px rgb(242 231 211 / 0.09),
      0 0 300px 110px rgb(242 231 211 / 0.045);
    will-change: transform, opacity;
  }
  .veil {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background: #040507; opacity: 0;
    will-change: opacity;
  }
  .glow-floor {
    position: fixed; left: 0; right: 0; bottom: 0; height: 46vh;
    z-index: 0; pointer-events: none; opacity: 0;
    background: radial-gradient(72% 82% at 50% 118%, rgb(158 168 188 / 0.15) 0%, rgb(158 168 188 / 0) 64%);
    will-change: opacity;
  }

  .page { position: relative; z-index: 1; }

  /* ============ Nav ============ */
  .site-nav {
    position: absolute; top: 0; left: 0; right: 0; z-index: 20;
    display: flex; align-items: center; justify-content: space-between;
    max-width: 800px; margin: 0 auto; padding: 20px;
  }
  .site-nav-name { color: var(--ink); text-decoration: none; font-weight: 700; font-size: 0.875rem; }
  .site-nav-links { display: flex; align-items: center; gap: 20px; }
  .site-nav-link {
    color: var(--ink-2); text-decoration: none; font-size: 0.875rem;
    transition: color .3s ease;
  }
  .site-nav-link:hover { color: var(--ink); }

  /* ============ Sections ============ */
  section { padding: 0 20px; max-width: 720px; margin: 0 auto; position: relative; }
  .hero { min-height: 100svh; display: flex; align-items: center; padding-top: 110px; }
  .about, .projects, .experience, .contact { padding-top: 16vh; padding-bottom: 4vh; }
  .contact { padding-bottom: 20vh; }

  .kicker {
    font-size: 0.78rem; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--ink-3); margin-bottom: 1.4rem;
  }
  .hero-name {
    font-size: clamp(2.6rem, 8vw, 4.4rem);
    font-weight: 700; letter-spacing: -0.02em; line-height: 1.05;
    color: var(--ink);
  }
  .hero-note { margin-top: 1.2rem; color: var(--ink-2); font-size: 0.95rem; max-width: 44ch; }
  .hero-hint {
    margin-top: 3.2rem; color: var(--ink-3); font-size: 0.8rem; letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .section-title {
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--ink-3);
    margin-bottom: 1.8rem;
  }

  .prose { color: var(--ink-2); font-size: 0.95rem; max-width: 60ch; }
  .prose p + p { margin-top: 1rem; }
  .scrim {
    background: rgb(7 8 11 / 52%);
    border-radius: 6px;
    padding: 22px 22px;
  }

  /* Depth marks between sections, quiet bathymetry */
  .mark {
    text-align: center; color: var(--ink-3); font-size: 0.78rem;
    letter-spacing: 0.3em; padding: 26vh 0 6vh; user-select: none;
  }

  /* ============ Lists ============ */
  .work-list { list-style: none; }
  .work-item {
    border-top: 1px solid var(--line);
    padding: 18px 4px;
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
  }
  .work-item:last-child { border-bottom: 1px solid var(--line); }
  .work-name { font-size: 1.02rem; font-weight: 700; color: var(--ink); }
  .work-sub { font-size: 0.82rem; color: var(--ink-3); margin-top: 2px; }
  .work-when { font-size: 0.78rem; color: var(--ink-3); flex-shrink: 0; }
  .work-link {
    color: var(--warm-dim); text-decoration: none; font-size: 0.85rem;
    border-bottom: 1px solid rgb(242 231 211 / 30%); padding-bottom: 2px;
    transition: color .3s ease, border-color .3s ease;
  }
  .work-link:hover { color: var(--warm); border-color: var(--warm); }

  /* ============ The crossing: gravity shifts here ============ */
  .crossing { padding-top: 22vh; padding-bottom: 10vh; text-align: center; }
  .crossing-inner { will-change: transform; }
  .crossing-title {
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.3em;
    text-transform: uppercase; color: var(--warm-dim); margin-bottom: 1.4rem;
  }
  .crossing-line { color: var(--ink-2); font-size: 0.95rem; max-width: 40ch; margin: 0 auto; }
  .crossing-line + .crossing-line { margin-top: 0.8rem; }

  /* ============ Contact ============ */
  .contact-links { display: flex; flex-direction: column; gap: 4px; }
  .contact-link {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 4px; color: var(--ink); text-decoration: none;
    border-top: 1px solid var(--line); font-size: 1rem;
    transition: padding .35s ease, color .35s ease;
  }
  .contact-link:last-child { border-bottom: 1px solid var(--line); }
  .contact-link:hover { color: var(--warm); padding-left: 10px; }
  .arrow { width: 18px; height: 18px; color: var(--ink-3); }

  .site-footer {
    position: relative; z-index: 1; text-align: center;
    padding: 40px 20px 56px; color: var(--ink-3); font-size: 0.78rem;
  }
  .site-footer a { color: var(--ink-2); text-decoration: none; }
  .site-footer a:hover { color: var(--ink); }

  /* ============ Reveal ============ */
  .reveal {
    opacity: 0;
    transform: translateY(26px);
    filter: blur(8px);
    transition: opacity 1.1s ease, transform 1.1s cubic-bezier(.22, 1, .36, 1), filter 1.1s ease;
  }
  .reveal.in { opacity: 1; transform: none; filter: none; }

  /* ============ Breathing text, almost imperceptible ============ */
  .breathe { animation: breathe 11s ease-in-out infinite; }
  @keyframes breathe {
    0%, 100% { transform: scale(1); opacity: 0.94; }
    50% { transform: scale(1.006); opacity: 1; }
  }

  /* ============ Tap pulse ============ */
  .pulse {
    position: fixed; z-index: 40; width: 14px; height: 14px;
    margin: -7px 0 0 -7px; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle,
      rgb(242 231 211 / 0.5) 0%,
      rgb(242 231 211 / 0.12) 42%,
      rgb(242 231 211 / 0) 70%);
    animation: pulse-out 1.4s cubic-bezier(.22, 1, .36, 1) forwards;
  }
  @keyframes pulse-out {
    from { transform: scale(1); opacity: 1; }
    to { transform: scale(26); opacity: 0; }
  }

  /* ============ Fixed chrome: depth meter + motion toggle ============ */
  .depth-meter {
    position: fixed; left: 18px; bottom: 16px; z-index: 30;
    font-size: 0.72rem; letter-spacing: 0.2em; color: var(--ink-3);
    pointer-events: none; user-select: none;
  }
  .motion-toggle {
    position: fixed; right: 16px; bottom: 12px; z-index: 30;
    font-family: inherit; font-size: 0.72rem; letter-spacing: 0.08em;
    color: var(--ink-2); background: rgb(11 12 17 / 60%);
    border: 1px solid rgb(255 255 255 / 18%); border-radius: 999px;
    padding: 8px 14px; cursor: pointer;
    transition: color .3s ease, border-color .3s ease;
  }
  .motion-toggle:hover { color: var(--ink); border-color: rgb(255 255 255 / 40%); }

  /* ============ Reduced motion: fully still ============ */
  .reduced .reveal { opacity: 1; transform: none; filter: none; transition: none; }
  .reduced .breathe, .reduced .pulse { animation: none !important; }
  .reduced .moon, .reduced .glow-warm, .reduced .glow-floor, .reduced .veil,
  .reduced .crossing-inner, .reduced .drift { transform: none !important; }

  @media (width >= 640px) {
    section { padding-left: 40px; padding-right: 40px; }
    .site-nav { padding: 24px 40px; }
  }
  @media (width >= 1024px) {
    section { max-width: 800px; padding-left: 24px; padding-right: 24px; }
  }
  @media (width <= 640px) {
    .site-nav { padding: 16px 20px; }
    .site-nav-links { gap: 14px; }
    .site-nav-link { font-size: 0.75rem; }
    .work-when { display: none; }
    .depth-meter { left: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; filter: none; transition: none; }
    .breathe, .pulse { animation: none !important; }
  }
</style>
