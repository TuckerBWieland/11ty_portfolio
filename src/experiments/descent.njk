<div class="depth-meter" aria-hidden="true">depth 000 m</div>
<button class="motion-toggle" id="motion-toggle" type="button" aria-pressed="false">Reduce motion</button>

<script>
(function () {
  'use strict';

  var params = new URLSearchParams(location.search);
  var root = document.documentElement;
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches || params.get('reduced') === '1';

  var moon = document.querySelector('.moon');
  var glowWarm = document.querySelector('.glow-warm');
  var glowFloor = document.querySelector('.glow-floor');
  var veil = document.querySelector('.veil');
  var meter = document.querySelector('.depth-meter');
  var crossingInner = document.querySelector('.crossing-inner');
  var toggle = document.getElementById('motion-toggle');
  var drifts = Array.prototype.slice.call(document.querySelectorAll('.drift'));

  var MAX_DEPTH_M = 240;
  var targetY = window.scrollY || window.pageYOffset || 0;
  var smoothY = targetY;
  var lastMeter = -1;
  var rafId = 0;
  var revealed = false;

  function maxScroll() {
    return Math.max(1, root.scrollHeight - window.innerHeight);
  }

  /* ============ Reveals ============ */
  function showAll() {
    if (revealed) return;
    revealed = true;
    document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
  }

  if ('IntersectionObserver' in window && !reduceMotion) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
  } else {
    showAll();
  }

  /* ============ Per-frame composition ============ */
  function compose(y) {
    var depth = Math.min(1, Math.max(0, y / maxScroll()));
    var vh = window.innerHeight;

    /* Moon: fixed in the world, so it recedes as you sink past it */
    var rise = (-depth * vh * 0.14).toFixed(1);
    var scale = (1 - depth * 0.16).toFixed(4);
    moon.style.transform = 'translate(-50%, -50%) translate3d(0,' + rise + 'px,0) scale(' + scale + ')';
    moon.style.opacity = (1 - depth * 0.62).toFixed(3);

    /* Warm interior light left behind above; page deepens below */
    glowWarm.style.opacity = (0.5 * (1 - depth * 0.88)).toFixed(3);
    glowWarm.style.transform = 'translate3d(0,' + (-depth * vh * 0.18).toFixed(1) + 'px,0)';
    veil.style.opacity = (depth * 0.62).toFixed(3);
    glowFloor.style.opacity = (depth * depth * 0.9).toFixed(3);

    /* Depth meter */
    var m = Math.round(depth * MAX_DEPTH_M);
    if (m !== lastMeter) {
      lastMeter = m;
      meter.textContent = 'depth ' + String(m).padStart(3, '0') + ' m';
    }

    /* Sections drift at slightly different rates: the sinking feel */
    for (var i = 0; i < drifts.length; i++) {
      var el = drifts[i];
      var rate = parseFloat(el.getAttribute('data-rate')) || 0;
      if (!rate) continue;
      var rect = el.getBoundingClientRect();
      var center = rect.top + rect.height / 2;
      var off = (center - vh / 2) * rate;
      if (off > 60) off = 60;
      if (off < -60) off = -60;
      el.style.transform = 'translate3d(0,' + off.toFixed(1) + 'px,0)';
    }

    /* The crossing: gravity shifts, content tilts and rises against the scroll */
    if (crossingInner) {
      var cRect = crossingInner.getBoundingClientRect();
      var cCenter = cRect.top + cRect.height / 2;
      var p = 1 - Math.min(1, Math.max(0, Math.abs(cCenter - vh / 2) / (vh * 0.75)));
      var arc = Math.sin(p * Math.PI);
      var rot = (arc * 1.6).toFixed(3);
      var lift = (-arc * 34).toFixed(1);
      crossingInner.style.transform = 'rotate(' + rot + 'deg) translate3d(0,' + lift + 'px,0)';
    }
  }

  function tick() {
    if (!reduceMotion && !document.hidden) {
      smoothY += (targetY - smoothY) * 0.12;
      if (Math.abs(targetY - smoothY) < 0.1) smoothY = targetY;
      compose(smoothY);
    }
    rafId = requestAnimationFrame(tick);
  }

  window.addEventListener('scroll', function () {
    targetY = window.scrollY || window.pageYOffset || 0;
  }, { passive: true });

  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) {
      targetY = window.scrollY || window.pageYOffset || 0;
      smoothY = targetY;
    }
  });

  /* ============ Tap pulse: a soft bloom of light where touched ============ */
  document.addEventListener('pointerdown', function (e) {
    if (reduceMotion) return;
    var p = document.createElement('div');
    p.className = 'pulse';
    p.style.left = e.clientX + 'px';
    p.style.top = e.clientY + 'px';
    document.body.appendChild(p);
    p.addEventListener('animationend', function () { p.remove(); });
  });

  /* ============ Reduce motion toggle ============ */
  function applyReduced(on) {
    reduceMotion = on;
    root.classList.toggle('reduced', on);
    toggle.setAttribute('aria-pressed', on ? 'true' : 'false');
    toggle.textContent = on ? 'Restore motion' : 'Reduce motion';
    if (on) {
      showAll();
      cancelAnimationFrame(rafId);
    } else {
      targetY = window.scrollY || window.pageYOffset || 0;
      smoothY = targetY;
      tick();
    }
  }
  toggle.addEventListener('click', function () { applyReduced(!reduceMotion); });

  if (reduceMotion) {
    root.classList.add('reduced');
    toggle.setAttribute('aria-pressed', 'true');
    toggle.textContent = 'Restore motion';
    showAll();
  } else {
    tick();
  }

  /* Screenshot helper: ?shot=mid lands on Projects */
  if (params.get('shot') === 'mid') {
    var target = document.querySelector('.projects');
    if (target) window.scrollTo(0, Math.max(0, target.offsetTop - 80));
  }
})();
</script>
